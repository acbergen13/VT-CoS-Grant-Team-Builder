# VT ARC LLM (OpenAI-compatible endpoint) — required
VT_ARC_API_KEY=
VT_ARC_BASE_URL=https://llm-api.arc.vt.edu/api/v1
# gpt-oss-120b returns clean JSON; thinking models (GLM-5.3*) can spend
# max_output_tokens on hidden reasoning and return empty content.
VT_ARC_MODEL=gpt-oss-120b

# Elsevier / Scopus API — required for data_source: elsevier (prod mode);
# not needed while running on the local CSVs.
ELSEVIER_API_KEY=
ELSEVIER_BASE_URL=https://api.elsevier.com

# Optional: institutional token for entitled Elsevier content off-campus
# ELSEVIER_INST_TOKEN=
